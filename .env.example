# Required for server-side TMDB API requests
TMDB_API_KEY=

# Optional compatibility name for the local Express server
TMDB_KEY=

# Local Express server
PORT=3000
DB_PATH=./data/cineframe.db

# Production Vercel account sync requires a persistent PostgreSQL database
DATABASE_URL=
APP_ORIGIN=https://cineframe-web.vercel.app

# Optional integrations
MAL_CLIENT_ID=
# Example format for an endpoint you own/are authorized to use:
# PROVIDER_URL=https://media.example.com/resolve?type={type}&id={id}&season={season}&episode={episode}
